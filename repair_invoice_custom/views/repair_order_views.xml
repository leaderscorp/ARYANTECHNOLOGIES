<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Inherit the standard repair.order form view
         ══════════════════════════════════════════════════════════════════ -->
    <record id="repair_order_form_view_invoice" model="ir.ui.view">
        <field name="name">repair.order.form.invoice.button</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- ── 1. Smart Button (top stat-buttons area) ─────────────── -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                        name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="invoice_count == 0"
                        help="View linked invoices">
                    <field
                            name="invoice_count"
                            widget="statinfo"
                            string="Invoices"/>
                </button>
            </xpath>

            <!-- ── 2. "Create Invoice" action button in the header ────── -->
            <xpath expr="//header/button[last()]" position="after">
                <button
                        name="action_create_repair_invoice"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('done', 'under_repair', '2binvoiced')"
                        help="Generate a customer invoice from this repair order"/>
            </xpath>

            <!-- Hide "Create Quotation" header button -->
            <xpath expr="//form/header/button[@name='action_create_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!--            &lt;!&ndash; Hide Sales Order smart button &ndash;&gt;-->
            <xpath expr="//div[hasclass('oe_button_box')]/button[@name='action_view_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='move_ids']//field[@name='price_unit']" position="after">
                <!--                <field name="price_unit" string="Unit Price"/>-->
                <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="price_subtotal" widget="monetary"/>
            </xpath>

            <xpath expr="//field[@name='move_ids']//field[@name='repair_line_type']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group class="oe_subtotal_footer oe_right" colspan="2" name="repair_total">
                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <div class="oe_subtotal_footer_separator oe_inline">
                        <label for="amount_total"/>
                    </div>
                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
                <div class="oe_clear"/>
            </xpath>

        </field>
    </record>

    <record id="view_repair_order_tree_inherit_site_location" model="ir.ui.view">
        <field name="name">repair.order.tree.inherit.site.location</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <!-- Find the 'name' field and add 'site_location' after it -->
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="site_location"/>
            </xpath>

        </field>
    </record>

    <record id="inherit_account_move_line" model="ir.ui.view">
        <field name="name">inherit.invoice.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="product_desc" optional="show"/>
            </xpath>

        </field>
    </record>




</odoo>
