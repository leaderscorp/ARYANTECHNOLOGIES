<odoo>
    <record id="account_move_form_inherit_repair_number" model="ir.ui.view">
        <field name="name">account.move.form.repair.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="/form//div[@name='journal_div']" position="after">
                <field name="repair_number"/>
                <field name="description_text"/>
                <field name="site_location"/>


            </xpath>


        </field>
    </record>
    
    <record id="account_move_search_inherit_desc" model="ir.ui.view">
        <field name="name">account.move.search.desc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <field name="site_location"/>
            </xpath>

        </field>
    </record>
</odoo>