<odoo>
    <template id="report_saleorder_document_inherit_repair"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//div[@id='informations']//div[t-field='doc.user_id']" position="after">
            <div class="col" t-if="doc.repair_number" name="informations_repair">
                <strong>Repair Number</strong>
                <div t-field="doc.repair_number"/>
            </div>
            <div class="col" t-if="doc.site_location" name="site_location">
                <strong>Site Location</strong>
                <div t-field="doc.site_location"/>
            </div>
        </xpath>

    </template>
</odoo>