<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View repair.fee View List -->
    <record id="view_repair_fee_list" model="ir.ui.view">
        <field name="name">view.repair.fee.list</field>
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View repair.fee form -->
    <record id="view_repair_fee_form" model="ir.ui.view">
        <field name="name">view.repair.fee.form</field>
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <form string="Repair Fee">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View repair.fee search -->
    <record id="view_repair_fee_search" model="ir.ui.view">
        <field name="name">view.repair.fee.search</field>
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action repair.fee -->
    <record id="action_repair_fee" model="ir.actions.act_window">
        <field name="name">Repair Fee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">repair.fee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Repair Fee.
            </p>
        </field>
    </record>

</odoo>
