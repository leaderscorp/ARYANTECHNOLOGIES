<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <template id="iman_account_payment_receipt" inherit_id="account.report_payment_receipt_document">
            <xpath expr="//t" position="replace">

                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>

                    <div class="page">

                        <div class="mb-4 mt-3">
                            <div class="row">
                                <div class="col-9 mb-1">
                                    <t t-if="o.journal_id.type == 'bank'">
                                        <span><b>Bank Account:</b></span>
                                        <span t-field="o.journal_id.default_account_id"/>
                                    </t>
                                    <t t-if="o.journal_id.type == 'cash'">
                                        <span><b>Cash Account:</b></span>
                                        <span t-field="o.journal_id.default_account_id"/>
                                    </t>
                                </div>
                                <div class="col-3 text-end" t-if="o.partner_type">
                                    <b>NTN no: </b>
                                    <span t-field="o.partner_id.vat"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 mb-1" t-if="o.partner_type">
                                    <b>Payment Receipt: </b>
                                    <span t-field="o.name"/>
                                </div>
                                <div class="col-6 mb-1 text-end" t-if="o.payment_method_id">
                                    <t t-if="o.journal_id.type == 'bank'">
                                        <span><b>Bank Code:</b></span>
                                    </t>
                                    <t t-if="o.journal_id.type == 'cash'">
                                        <span><b>Cash Code</b></span>
                                    </t>
                                    <span t-field="o.outstanding_account_id.code"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" t-if="o.amount">
                                    <b>Voucher No:</b>
                                    <span t-field="o.custom_name"/>
                                </div>
                                <div class="col-6 text-end" t-if="o.memo">
                                    <b>Date:</b>
                                    <span t-field="o.date"/>
                                </div>
                            </div>
                        </div>

                        <!-- ✅ Guard: Only process partials if move_id exists and is a singleton -->
                        <t t-if="o.move_id and o.move_id.id">
                            <t t-set="partials" t-value="o.move_id._get_reconciled_invoices_partials()[0]"/>
                            <t t-set="invoices" t-value="{partial[2].move_id for partial in partials}"/>
                            <!-- Check if invoices include different currencies -->
                            <t t-foreach="invoices" t-as="inv">
                                <t t-if="any(inv.currency_id != par[2].currency_id for par in inv._get_reconciled_invoices_partials()[0])"
                                   t-set="otherCurrency" t-value="True"/>
                            </t>
                        </t>
                        <!-- ✅ Fallback: empty sets when no move_id -->
                        <t t-else="">
                            <t t-set="partials" t-value="[]"/>
                            <t t-set="invoices" t-value="[]"/>
                        </t>

                        <t t-set="com" t-value="o.with_context(lang=lang)"/>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width:40%;">
                                        <div class="row">
                                            <div class="col-8 text-start">
                                                <span>Account Title</span>
                                            </div>
                                            <div class="col-4 text-end">
                                                <span>Account Code</span>
                                            </div>
                                        </div>
                                    </th>

                                    <t t-if="o.reconciled_invoice_ids">
                                        <th style="width:10%;">Invoice Number</th>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <th style="width:10%;">Bill Number</th>
                                    </t>

                                    <th>
                                        <span>Reference</span>
                                    </th>

                                    <t t-if="o.reconciled_invoice_ids">
                                        <th style="width:10%;">
                                            <span>Invoice Amount</span>
                                        </th>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <th style="width:10%;">
                                            <span>Bill Amount</span>
                                        </th>
                                    </t>

                                    <th class="text-center" style="width:10%;">
                                        <span>Paid Amount</span>
                                    </th>
                                    <th class="text-center" style="width:10%;">
                                        <span>Balance</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="row">
                                            <div class="col-8 text-start">
                                                <span t-field="com.partner_id"/>
                                            </div>
                                            <div class="col-4 text-end">
                                                <span t-field="com.destination_account_id.code"/>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- ✅ Invoice/Bill reference cells -->
                                    <t t-if="o.reconciled_invoice_ids">
                                        <td class="text-end">
                                            <span class="text-capitalize" t-field="o.inv_id_ref"/>
                                        </td>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <td class="text-end">
                                            <span class="text-capitalize" t-field="o.bill_id_ref"/>
                                        </td>
                                    </t>

                                    <td class="text-end">
                                        <span class="text-capitalize" t-field="o.memo"/>
                                    </td>

                                    <!-- ✅ Invoice/Bill total cells -->
                                    <t t-if="o.reconciled_invoice_ids">
                                        <td class="text-end">
                                            <span t-out="'{:,.2f}'.format(o.inv_balance_ref_total)"
                                                  t-options="{'widget': 'Float'}"/>
                                        </td>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <td class="text-end">
                                            <span t-out="'{:,.2f}'.format(o.bill_balance_ref_total)"
                                                  t-options="{'widget': 'Float'}"/>
                                        </td>
                                    </t>

                                    <td class="text-end">
                                        <span t-out="'{:,.2f}'.format(com.amount)"
                                              t-options="{'widget': 'Float'}"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="o.reconciled_invoice_ids">
                                            <span t-out="'{:,.2f}'.format(o.inv_balance_ref_total - com.amount)"/>
                                        </t>
                                        <t t-if="o.reconciled_bill_ids">
                                            <span t-out="'{:,.2f}'.format(o.bill_balance_ref_total - com.amount)"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>

                            <!-- ✅ Totals row -->
                            <tbody>
                                <tr>
                                    <td class="text-center fw-bold">
                                        <span>Total Amount</span>
                                    </td>

                                    <t t-if="o.reconciled_invoice_ids">
                                        <td class="text-end"></td>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <td class="text-end"></td>
                                    </t>

                                    <td class="text-end"></td>

                                    <t t-if="o.reconciled_invoice_ids">
                                        <td class="text-end">
                                            <span t-out="'{:,.2f}'.format(o.inv_balance_ref_total)"
                                                  t-options="{'widget': 'Float'}"/>
                                        </td>
                                    </t>
                                    <t t-if="o.reconciled_bill_ids">
                                        <td class="text-end">
                                            <span t-out="'{:,.2f}'.format(o.bill_balance_ref_total)"
                                                  t-options="{'widget': 'Float'}"/>
                                        </td>
                                    </t>

                                    <td class="text-end">
                                        <span t-out="'{:,.2f}'.format(com.amount)"
                                              t-options="{'widget': 'Float'}"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="o.reconciled_invoice_ids">
                                            <span t-out="'{:,.2f}'.format(o.inv_balance_ref_total - com.amount)"/>
                                        </t>
                                        <t t-if="o.reconciled_bill_ids">
                                            <span t-out="'{:,.2f}'.format(o.bill_balance_ref_total - com.amount)"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <br/>
                        <br/>
                        <span class="fw-bold">Rupees: </span>
                        <span class="text-capitalize" t-field="o.total_in_words"/>
                        <br/>

                    </div>

                    <div class="footer">
                        <div class="row">
                            <div class="col-auto text-center">
                                <p class="mb-1">_______________________</p>
                                <b>Receipient Sign</b>
                            </div>
                            <div class="col-auto text-center">
                                <p class="mb-1">_______________________</p>
                                <b>Prepared by</b>
                            </div>
                            <div class="col-auto text-center">
                                <p class="mb-1">_______________________</p>
                                <b>Checked by</b>
                            </div>
                            <div class="col-auto text-center">
                                <p class="mb-1">_______________________</p>
                                <b>Finance by</b>
                            </div>
                            <div class="col-auto text-center">
                                <p class="mb-1">_______________________</p>
                                <b>Approved by</b>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>