<odoo>
    <data>

        <!-- List View -->
        <record id="requisition_received_list_view_user" model="ir.ui.view">
            <field name="name">requisition.received.list.user</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <list string="Received Requisitions" create="false">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="requestor_name"/>
                    <field name="req_picking_type"/>
                    <button type="object"
                            name="get_formview_action_received"
                            string="View Request"
                            icon="fa-edit"/>
                </list>
            </field>
        </record>


        <!-- Form View -->
        <record id="requisition_form_view_received_user" model="ir.ui.view">
            <field name="name">requisition.received.form.user</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <form create="false">
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,sent,approved"/>

                        <button name="action_transfer"
                                string="Create Transfer"
                                type="object"
                                class="btn-primary"
                                invisible="state in ('draft','approved') or transfer_created"/>
                    </header>

                    <sheet>
                        <group>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </group>

                        <group>
                            <field name="req_from" readonly="id != False"/>
                            <field name="transfer_created" readonly="1"/>
                            <field name="req_transfer_id_state" readonly="1"/>

                            <field name="req_to" readonly="id != False"/>

                            <field name="req_picking_type" readonly="id != False"/>
                            <field name="req_transfer_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="location_dest_id" readonly="state in ('sent','approved')"/>
                            <field name="date_field" readonly="1"/>
                            <field name="description" readonly="1"/>
                        </group>

                        <notebook>
                            <page string="Products Information">
                                <field name="req_line_ids" widget="one2many_list">
                                    <list editable="bottom" create="0" edit="1">
                                        <field name="product_id"/>
                                        <field name="product_uom_quantity"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="requisition_received_action_user" model="ir.actions.act_window">
            <field name="name">Requisitions Received</field>
            <field name="res_model">request.model</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('req_to', '=', context.get('uid'))]</field>
        </record>


        <!-- Action Views -->
        <!-- <record id="requisition_received_list_user" model="ir.actions.act_window.view">
            <field name="view_mode">list</field>
            <field name="view_id" ref="requisition_received_list_view_user"/>
            <field name="act_window_id" ref="requisition_received_action_user"/>
        </record>

        <record id="requisition_received_form_user" model="ir.actions.act_window.view">
            <field name="view_mode">form</field>
            <field name="view_id" ref="requisition_form_view_received_user"/>
            <field name="act_window_id" ref="requisition_received_action_user"/>
        </record> -->


        <!-- Root Menu -->
        <menuitem id="menu_requisition_root" name="Requisition Module"/>

        <!-- Sub Menu -->
        <menuitem id="menu_requisitions_received_user"
                  name="Requisitions Received"
                  parent="menu_requisition_root"
                  action="requisition_received_action_user"
                  sequence="10"/>

    </data>
</odoo>