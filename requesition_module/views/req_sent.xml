<odoo>
    <data>

        <!-- List View -->
        <record id="requisition_sent_list_view" model="ir.ui.view">
            <field name="name">requisition.sent.list</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <list string="Sent Requisitions">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="recipient_name"/>
                    <field name="req_picking_type"/>
                    <button type="object"
                            name="get_formview_action_sent"
                            string="View Request"
                            icon="fa-edit"/>
                </list>
            </field>
        </record>


        <!-- Form View -->
        <record id="requisition_form_view_sent" model="ir.ui.view">
            <field name="name">requisition.sent.form</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,sent,approved"/>
                    </header>

                    <sheet>
                        <group>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </group>

                        <group>
                            <field name="req_from" readonly="1"/>
                            <field name="req_to"
                                   readonly="id != False"
                                   domain="[('id','!=',uid)]"/>

                            <field name="req_picking_type" readonly="id != False"/>
                        </group>

                        <group>
                            <field name="location_dest_id"/>
                            <field name="date_field" readonly="1"/>
                            <field name="description" readonly="id != False"/>
                        </group>

                        <notebook>
                            <page string="Products Information">
                                <field name="req_line_ids"
                                       widget="one2many_list"
                                       readonly="state in ('sent','approved')">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_uom_quantity"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="requisition_sent_action" model="ir.actions.act_window">
            <field name="name">Requisitions Sent</field>
            <field name="res_model">request.model</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('req_from', '=', uid)]</field>
        </record>


        <!-- Action Views -->
        <!-- <record id="requisition_sent_list_action_view" model="ir.actions.act_window.view">
            <field name="view_mode">list</field>
            <field name="view_id" ref="requisition_sent_list_view"/>
            <field name="act_window_id" ref="requisition_sent_action"/>
        </record>

        <record id="requisition_sent_form_action_view" model="ir.actions.act_window.view">
            <field name="view_mode">form</field>
            <field name="view_id" ref="requisition_form_view_sent"/>
            <field name="act_window_id" ref="requisition_sent_action"/>
        </record> -->


        <!-- Menu -->
        <menuitem id="menu_requisitions_sent"
                  name="Requisitions Sent"
                  parent="requesition_module.menu_requisition_root"
                  action="requisition_sent_action"
                  sequence="20"/>

    </data>
</odoo>