<odoo>
    <data>

        <!-- List View -->
        <record id="requisition_received_list_view" model="ir.ui.view">
            <field name="name">requisition.received.list</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <list string="Received Requisitions" create="false">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="requestor_name"/>
                    <field name="req_picking_type"/>
                    <button type="object" name="get_formview_action_received"
                            string="View Request" icon="fa-edit"/>
                </list>
            </field>
        </record>


        <!-- Form View -->
        <record id="requisition_form_view_received" model="ir.ui.view">
            <field name="name">requisition.received.form</field>
            <field name="model">request.model</field>
            <field name="arch" type="xml">
                <form create="false">
                    <header>
                        <field name="is_after_sales_user" invisible="1"/>
                        <button name="action_sent"
                                string="Sent"
                                type="object"
                                class="btn-primary"
                                invisible="state in ('sent','approved')"/>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="state in ('draft','approved') or is_after_sales_user"/>

                        <button name="action_transfer"
                                string="Create Transfer"
                                type="object"
                                class="btn-primary"
                                invisible="state in ('draft','approved') or transfer_created"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,sent,approved"/>

                            
                    </header>

                    <sheet>
                        <group>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </group>

                        <group>
                            <field name="req_from" readonly="state not in ['sent', 'approved']"/>
                            <field name="transfer_created" readonly="1"/>
                            <field name="req_transfer_id_state" readonly="1"/>

                            <field name="req_to" readonly="state not in ['sent', 'approved']"/>

                            <field name="req_picking_type" readonly="state not in ['sent', 'approved']"/>
                            <field name="req_transfer_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="location_dest_id" readonly="state in ('sent','approved')"/>
                            <field name="date_field" readonly="1"/>
                            <field name="description" readonly="state not in ['sent', 'approved']"/>
                        </group>

                        <notebook>
                            <page string="Products Information">
                                <field name="req_line_ids"
                                       widget="one2many_list"
                                       readonly="state in ('sent','approved')">
                                    <list editable="bottom" create="1" edit="1">
                                        <field name="product_id"/>
                                        <field name="product_uom_quantity"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="requisition_received_action" model="ir.actions.act_window">
            <field name="name">All Requisitions</field>
            <field name="res_model">request.model</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Root Menu -->
        <menuitem id="menu_requisition_root" name="Requisition Module"/>

        <!-- Sub Menu -->
        <menuitem id="menu_requisitions_received"
                  name="All Requisitions Received"
                  parent="menu_requisition_root"
                  action="requisition_received_action"
                  sequence="10"/>

    </data>
</odoo>
