<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="repair_report_inherit_template" inherit_id="repair.report_repairorder">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="currency" t-value="o.company_id.currency_id"/>
                <t t-set="parts_total" t-value="sum(line.price_unit * line.product_uom_qty for line in o.move_ids)"/>

                <div class="container">
                    <div class="row">
                        <div class="col-6">
                            <t t-set="company" t-value="o.company_id"/>
                            <b>Date:</b>
                            <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" t-options="{'widget': 'date'}" class="m-0"/>
                            <br/>
                            <b>Supplier Name:</b>
                            <span t-field="company.name"/>
                            <br/>
                            <b>Job Completion Date:</b>
                            <span t-field="o.job_completion_date"/>
                            <br/>
                            <b>Invoice No:</b>
                            <span t-field="o.name"/>
                            <br/>
                            <b>Invoice Date:</b>
                            <span t-field="o.inv_date"/>
                            <br/>
                            <b>Address:</b>
                            <span t-field="company.street"/>
                            <br/>
                            <b>Telephone:</b>
                            <span t-field="company.phone"/>
                            <br/>
                            <b>NTN:</b>
                            <span t-field="company.vat"/>
                            <br/>
                            <b>Site Location:</b>
                            <span t-field="o.site_location"/>
                            <br/>
                            <b>Description:</b>
                            <span t-field="o.description_text"/>
                            <br/>

                        </div>
                        <div class="col-6">
                            <b>Buyer's Name:</b>
                            <span t-field="o.partner_id.name"/>
                            <br/>
                            <b>Buyer's Address:</b>
                            <span t-field="o.partner_id.street"/>
                            <br/>
                            <b>Buyer's NTN:</b>
                            <span t-field="o.partner_id.vat"/>
                            <br/>
                        </div>
                    </div>
                </div>

                <div class="page">
                    <div class="oe_structure"/>

                    <h2 class="text-center mt-4 mb-4">QUOTATION</h2>

                    <div t-if="o.description" class="mb-3">
                        <strong>Description:</strong>
                        <span t-field="o.description"/>
                    </div>

                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-center">Products</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-center">Rate Per Unit</th>
                                <th class="text-center">Taxes</th>
                                <th class="text-center">Subtotal</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_ids" t-as="line">
                                <td>
                                    <span t-if="line.repair_line_type == 'add'">(Add) </span>
                                    <span t-if="line.repair_line_type == 'remove'">(Remove) </span>
                                    <span t-if="line.repair_line_type == 'recycle'">(Recycle) </span>
                                    <span t-field="line.description_picking"/>
<!--                                    <div t-if="line.description_picking" class="text-muted">-->
<!--                                        <span t-field="line.description_picking"/>-->
<!--                                    </div>-->
                                </td>
                                <td class="text-center">
                                    <span t-field="line.product_uom_qty"/>
                                    <span groups="uom.group_uom" t-field="line.product_uom.name"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td class="text-center">
                                    <t t-if="line.tax_ids">
                                        <span t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                                    </t>
                                </td>

                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">
                                    Untaxed Amount
                                </td>
                                <td class="text-end">
                                    <span t-field="o.amount_untaxed"
                                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" class="text-end fw-bold">
                                    Taxes
                                </td>
                                <td class="text-end">
                                    <span t-field="o.amount_tax"
                                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>

                            <tr class="border-top border-dark">
                                <td colspan="4" class="text-end fw-bold">
                                    Grand Total
                                </td>
                                <td class="text-end fw-bold">
                                    <span t-field="o.amount_total"
                                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>

                            <tr t-if="o.total_in_wordss">
                                <td colspan="5" class="text-uppercase text-center fw-bold border-top border-dark">
                                    <span t-field="o.total_in_wordss"/>
                                    <span style="margin-left:5px;">Only</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 style="margin-top: 20px;">Terms And Condition</h4>
                    <p t-field="o.quotation_notes"/>
                    <div class="oe_structure"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
