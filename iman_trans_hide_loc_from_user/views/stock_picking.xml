<odoo>
    <data>
        <record id="iman_picking_loc_locations" model="ir.ui.view">
            <field name="name">iman_picking_loc_locations</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="loc_ids" invisible="1"/>
                    <field name="dest_loc_ids" invisible="1"/>
                    <field name="pick_ids" invisible="1"/>
                </xpath>

                <xpath expr="/form/sheet/group/group/field[@name='picking_type_id']" position="after">
                    <field name="location_id" domain="[('id', 'in', loc_ids)]"/>
                    <field name="location_dest_id" domain="[('id', 'in', dest_loc_ids)]"/>
                </xpath>
                <xpath expr="/form/sheet/group/group/field[@name='picking_type_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', pick_ids)]</attribute>
                </xpath>


                <!--Operations-->
               
                <xpath expr="/form/sheet/notebook/page[@name='operations']/field[@name='move_ids']/list//field[@name='forecast_availability']" position="after">
                    <field name="location_id" optional="show" domain="[('id', 'in', parent.loc_ids)]"/>
                </xpath>
                
                <xpath expr="/form/sheet/notebook/page[@name='operations']/field[@name='move_ids']/list//field[@name='product_uom_qty']" position="after">
                    <field name="location_dest_id" optional="show" domain="[('id', 'in', parent.dest_loc_ids)]"/>
                    <field name="picking_type_id" optional="show" domain="[('id', 'in', parent.pick_ids)]"/>
                </xpath>

                <!--Detailed Operation-->
                <!--<xpath expr="//field[@name='move_line_ids_without_package']/tree/field[@name='location_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', parent.loc_ids)]</attribute>
                </xpath>

                <xpath expr="//field[@name='move_line_ids_without_package']/tree/field[@name='location_dest_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', parent.dest_loc_ids)]</attribute>
                </xpath>-->


            </field>
        </record>
    </data>
</odoo>