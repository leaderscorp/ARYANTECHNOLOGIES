<odoo>
    <data>
        <record id="iman_repair_loc_locations" model="ir.ui.view">
            <field name="name">iman_picking_loc_locations</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="loc_ids" invisible="1"/>
                </xpath>
               
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="location_id" domain="[('id', 'in', loc_ids)]"/>
                </xpath>
                
                 <xpath expr="/form/sheet/notebook/page[@name='parts']/field[@name='move_ids']/list//field[@name='product_uom']" position="after">
                    <field name="location_id" domain="[('id', 'in', parent.loc_ids)]" invisible="1"/>
                    <field name="location_dest_id" domain="[('id', 'in', parent.loc_ids)]" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>