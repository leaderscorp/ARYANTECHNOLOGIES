<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_vision_tax_invoice_document">
        <t t-call="web.basic_layout">
            <style>
                @page {
                    size: A4 portrait;
                    margin: 2mm 5mm 5mm 5mm;
                }

                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-family: Verdana, Helvetica, sans-serif;
                    font-size: 10px;
                    color: #000000;
                }

                .invoice-container {
                    width: 100%;
                    border: 2px solid #000000;
                    box-sizing: border-box;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin: 0;
                }

                th, td {
                    border: 1px solid #000000;
                    padding: 3px 5px;
                    vertical-align: top;
                    word-wrap: break-word;
                }

                .bold { font-weight: bold; }
                .center { text-align: center; }
                .right { text-align: right; }

                /* Header Styling (Fixed White Background for Logo Cell) */
                .header-logo-cell {
                    background-color: #ffffff;
                    padding: 4px 8px;
                    height: 45px;
                    vertical-align: middle;
                    border-bottom: 2px solid #000000;
                }

                .header-title-cell {
                    text-align: center;
                    font-size: 13px;
                    font-weight: bold;
                    letter-spacing: 1px;
                    padding: 4px 0;
                    background-color: #ffffff;
                    border-bottom: 2px solid #000000;
                }

                /* Line Items Table Styling */
                .table-headers th {
                    text-align: center;
                    font-weight: bold;
                    font-size: 9px;
                    padding: 4px 2px;
                    background-color: #ffffff;
                }

                /* Column Widths */
                .col-sr { width: 7%; text-align: center; }
                .col-desc { width: 45%; text-align: left; }
                .col-qty { width: 10%; text-align: center; }
                .col-rate { width: 13%; text-align: right; }
                .col-total { width: 25%; text-align: right; }

                /* Bank Details Alignment */
                .bank-block {
                    padding: 6px 0 6px 45px;
                    line-height: 1.6;
                    font-size: 10px;
                }
                .bank-label {
                    display: inline-block;
                    width: 85px;
                    font-weight: bold;
                }

                /* Signature Block */
                .signature-container {
                    padding: 8px;
                    height: 85px;
                    border: 1px solid #000000;
                }
            </style>

            <div class="page">
                <div class="invoice-container">

                    <!-- Top Banner (Logo & TAX INVOICE Header - Plain White Background) -->
                    <table>
                        <tr>
                            <td colspan="2" class="header-logo-cell">
                                <t t-if="o.company_id.logo">
                                    <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 40px; max-width: 250px; object-fit: contain; display: block;"/>
                                </t>
                                <t t-else="">
                                    <span style="color: #000000; font-size: 18px; font-weight: bold;" t-field="o.company_id.name"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="header-title-cell">
                                TAX INVOICE
                            </td>
                        </tr>
                    </table>

                    <!-- Header Info Section -->
                    <table>
                        <tr>
                            <td style="padding: 6px 8px; border-bottom: 2px solid #000000;">
                                <div style="width: 100%; clear: both;">
                                    <div style="width: 60%; float: left;">
                                        <div><span class="bold">FROM&#160;&#160;&#160;&#160;: </span><span t-field="o.company_id.name"/></div>
                                        <div>
                                            <span class="bold">ADDRESS: </span>
                                            <span t-field="o.company_id.street"/>
                                            <t t-if="o.company_id.street2">, <span t-field="o.company_id.street2"/></t>
                                            <t t-if="o.company_id.city">, <span t-field="o.company_id.city"/></t>
                                            <t t-if="o.company_id.country_id">, <span t-field="o.company_id.country_id.name"/></t>
                                        </div>
                                        <div><span class="bold">TEL&#160;&#160;&#160;&#160;&#160;&#160;&#160;: </span><span t-field="o.company_id.phone"/></div>
                                        <div><span class="bold">TRN&#160;&#160;&#160;&#160;&#160;&#160;&#160;: </span><span t-field="o.company_id.vat"/></div>
                                    </div>
                                    <div style="width: 40%; float: right;">
                                        <div><span class="bold">INVOICE NO.&#160;: </span><span t-field="o.name"/></div>
                                        <div>
                                            <span class="bold">INVOICE DATE : </span>
                                            <span t-field="o.invoice_date" t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/>
                                        </div>
                                    </div>
                                </div>

                                <div style="height: 10px; clear: both;"></div>

                                <div style="width: 100%; clear: both;">
                                    <div style="width: 60%; float: left;">
                                        <div><span class="bold">BUYER&#160;&#160;&#160;: </span><span t-field="o.partner_id.name"/></div>
                                        <div><span class="bold">TEL&#160;&#160;&#160;&#160;&#160;&#160;&#160;: </span><span t-field="o.partner_id.phone"/></div>
                                        <div><span class="bold">TRN&#160;&#160;&#160;&#160;&#160;&#160;&#160;: </span><span t-field="o.partner_id.vat"/></div>
                                    </div>
                                    <div style="width: 40%; float: right;">
                                        <div><span class="bold">PCC.LPO&#160;&#160;&#160;&#160;&#160;: </span><span t-field="o.ref"/></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Items Table -->
                    <table>
                        <thead>
                            <tr class="table-headers">
                                <th class="col-sr">SR.No</th>
                                <th class="col-desc">DESCRIPTION</th>
                                <th class="col-qty">QTY</th>
                                <th class="col-rate">RATE</th>
                                <th class="col-total">TOTAL AMT-EXCLUDING VAT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr" t-value="1"/>
                            <t t-set="lines" t-value="o.invoice_line_ids or o.line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"/>
                            <t t-foreach="lines" t-as="line">
                                <t t-if="not line.display_type or line.display_type == 'product'">
                                    <tr>
                                        <td class="col-sr center"><span t-esc="sr"/></td>
                                        <td class="col-desc">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="col-qty center">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td class="col-rate right">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="col-total right">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <t t-set="sr" t-value="sr + 1"/>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Dynamic Totals Breakdown Section -->
                    <t t-set="paid_val" t-value="o.amount_total - o.amount_residual"/>
                    <t t-set="advance_pct" t-value="round((paid_val / o.amount_total * 100), 0) if o.amount_total else 0"/>
                    <t t-set="rem_pct" t-value="100 - advance_pct"/>

                    <table>
                        <tr>
                            <td class="col-sr"></td>
                            <td class="col-desc bold">TOTAL AMOUNT</td>
                            <td class="col-qty"></td>
                            <td class="col-rate"></td>
                            <td class="col-total bold right">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="bold">VAT 5%</td>
                            <td></td>
                            <td></td>
                            <td class="bold right">
                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="bold">NET AMOUNT INCLUDING 5% VAT</td>
                            <td></td>
                            <td class="center bold"><span t-field="o.currency_id.name"/></td>
                            <td class="bold right">
                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <!-- Dynamic Advance Payment Check -->
                        <t t-if="paid_val &gt; 0">
                            <tr>
                                <td></td>
                                <td class="bold"><span t-esc="int(advance_pct)"/>% Advance Payment</td>
                                <td></td>
                                <td></td>
                                <td class="bold right">
                                    <span t-esc="paid_val" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="bold">Remaining <span t-esc="int(rem_pct)"/>% Balance</td>
                                <td></td>
                                <td class="center bold"><span t-field="o.currency_id.name"/></td>
                                <td class="bold right">
                                    <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <!-- AMOUNT IN WORDS -->
                    <table>
                        <tr>
                            <td style="padding: 4px 8px;">
                                <div class="bold" style="text-align: left; font-size: 10px;">
                                    AMOUNT IN WORDS&#160;&#160;<span t-field="o.currency_id.name"/>:
                                </div>
                                <div class="bold" style="text-align: center; font-size: 10px; text-transform: capitalize; margin-top: 3px;">
                                    <t t-if="o.amount_residual &gt; 0">
                                        <t t-esc="o.currency_id.amount_to_text(o.amount_residual)"/> Only.
                                    </t>
                                    <t t-else="">
                                        <t t-esc="o.currency_id.amount_to_text(o.amount_total)"/> Only.
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- BANK DETAILS SECTION -->
                    <table>
                        <tr>
                            <td class="center bold" style="background-color: #ffffff; font-size: 11px;">BANK DETAILS</td>
                        </tr>
                        <tr>
                            <td style="padding: 0;">
                                <div class="bank-block">
                                    <div>
                                        <span class="bank-label">Bank</span>:
                                        <span t-if="o.partner_bank_id.bank_id" t-field="o.partner_bank_id.bank_id.name"/>
                                        <t t-elif="o.company_id.partner_id.bank_ids">
                                            <span t-field="o.company_id.partner_id.bank_ids[0].bank_id.name"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span class="bank-label">AC Title</span>:
                                        <t t-if="o.partner_bank_id.acc_holder_name"><span t-field="o.partner_bank_id.acc_holder_name"/></t>
                                        <t t-elif="o.partner_bank_id"><span t-field="o.company_id.name"/></t>
                                        <t t-elif="o.company_id.partner_id.bank_ids">
                                            <span t-field="o.company_id.partner_id.bank_ids[0].acc_holder_name or o.company_id.name"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span class="bank-label">Ac Num</span>:
                                        <span t-if="o.partner_bank_id" t-field="o.partner_bank_id.acc_number"/>
                                        <t t-elif="o.company_id.partner_id.bank_ids">
                                            <span t-field="o.company_id.partner_id.bank_ids[0].acc_number"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span class="bank-label">IBAN</span>:
                                        <span t-if="o.partner_bank_id" t-field="o.partner_bank_id.sanitized_acc_number"/>
                                        <t t-elif="o.company_id.partner_id.bank_ids">
                                            <span t-field="o.company_id.partner_id.bank_ids[0].sanitized_acc_number"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span class="bank-label">CURRENCY</span>:
                                        <span t-field="o.currency_id.name"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Receiver & Signature -->
                    <div class="signature-container">
                        <div style="width: 100%; clear: both;">
                            <div style="width: 50%; float: left;" class="bold">
                                Receiver :
                            </div>
                        </div>
                        <div style="width: 100%; clear: both; margin-top: 55px;">
                            <div style="width: 50%; float: left;" class="bold">
                                Name &amp; Signature
                            </div>
                            <div style="width: 50%; float: right; text-align: right;" class="bold">
                                Name &amp; Signature
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <!-- Calling Wrapper Template -->
    <template id="report_vision_tax_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_tax_invoice.report_vision_tax_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>