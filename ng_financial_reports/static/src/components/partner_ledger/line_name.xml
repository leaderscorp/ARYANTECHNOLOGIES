<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="ng_financial_reports.PartnerLedgerLineNameT" t-inherit="account_reports.PartnerLedgerLineName">
        <xpath expr="//td[@data-id='line_name']//div[hasclass('wrapper')]//div[hasclass('content')]" position="inside">
            <t t-if="props.line.unfoldable">
                <button
                        class="btn btn_action" t-on-click="(ev) => controller.reportAction(ev, 'print_testt', { line_id: props.line.id })">
                    Open PDC
                </button>
                <button
                        class="btn btn_action" t-on-click="(ev) => controller.reportAction(ev, 'print_repp', { line_id: props.line.id })">
                    Print PDC
                </button>
            </t>
        </xpath>
    </t>
</templates>
