<odoo>
    <data>
        <template id="report_pdc_full_pdf">
            <t t-set="data_report_landscape" t-value="True"/>
            <t t-call="web.external_layout">
                <main>
                    <div class="page">
                        <h2 class="text-center">Partner Ledger Report with PDC</h2>
                        <h5 class="text-center">
                            Date Range:
                            <t t-out="date_opt.get('date_from')"/>
                            -
                            <t t-out="date_opt.get('date_to')"/>
                        </h5>
                        <br/>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Name</th>
                                    <th>Reference</th>
                                    <th>Journal</th>
                                    <th>Account</th>
                                    <th>Invoice Date</th>
                                    <th>Due Date</th>
                                    <th>Matching</th>
                                    <th>Debit</th>
                                    <th>Credit</th>
                                    <th>Amount Currency</th>
                                    <th>Balance</th>
                                </tr>
                            </thead>
                            <t t-foreach="dta" t-as="line">
                                <t t-set="aml_dta" t-value="line[0]"/>
                                <t t-set="pdc_dta" t-value="line[1]"/>
                                <t t-set="aml_init_dta" t-value="line[2]"/>
                                <t t-set="pdc_init_dta" t-value="line[3]"/>
                                <tbody>
                                    <tr>
                                        <td colspan="8">
                                            Initial Balance
                                        </td>
                                        <td class="text-end">
                                            <span t-out="aml_init_dta.get('debit', 0.0)"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="aml_init_dta.get('credit', 0.0)"/>
                                        </td>
                                        <td class="text-end">
                                        </td>
                                        <td class="text-end">
                                            <span t-out="aml_init_dta.get('balance', 0.0)"/>
                                        </td>
                                    </tr>
                                    <t t-set="running_balance" t-value="aml_init_dta.get('balance', 0.0)"/>

                                    <t t-foreach="aml_dta" t-as="line">
                                        <t t-set="customer"
                                           t-value="docs.env['res.partner'].browse(line.get('partner_id'))"/>
                                        <t t-set="currency"
                                           t-value="docs.env['res.currency'].browse(line.get('currency_id'))"/>
                                        <tr>
                                            <td>
                                                <span t-out="customer.name"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('move_name')"/>
                                                -
                                                <t t-out="line.get('ref')"/>
                                                -
                                                <t t-out="line.get('name')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('ref') or line.get('invoice_origin')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('journal_name')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('account_code')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('invoice_date')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('date_maturity')"/>
                                            </td>
                                            <td>
                                                <t t-out="line.get('matching_number')"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="line.get('debit')"
                                                   t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="line.get('credit')"
                                                   t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </td>
                                            <td class="text-end">
                                                <!--<t t-out="line.get('amount_currency')"/>-->
                                            </td>
                                            <td class="text-end">
                                                <t t-set="running_balance" t-value="running_balance + line.get('balance', 0.0)"/>
                                                <!--<span t-out="line.get('balance')"-->
                                                <span t-out="running_balance"
                                                   t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="pdc_dta">
                                        <!--PDC Heading Row-->
                                        <tr>
                                            <td colspan="12">
                                                <h5>PDC</h5>
                                            </td>
                                        </tr>

                                        <!--PDC Row-->
                                        <tr>
                                            <td colspan="8">
                                                Initial Balance
                                            </td>
                                            <td class="text-end">
                                                <span t-out="pdc_init_dta.get('debit', 0.0)"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="pdc_init_dta.get('credit', 0.0)"/>
                                            </td>
                                            <td class="text-end">
                                            </td>
                                            <td class="text-end">
                                                <span t-out="pdc_init_dta.get('balance', 0.0)"/>
                                            </td>
                                        </tr>
                                        <t t-set="pdc_running_balance" t-value="pdc_init_dta.get('balance', 0.0)"/>
                                        <t t-foreach="pdc_dta" t-as="line">
                                            <t t-set="customer"
                                               t-value="docs.env['res.partner'].browse(line.get('partner_id'))"/>
                                            <t t-set="currency"
                                               t-value="docs.env['res.currency'].browse(line.get('currency_id'))"/>
                                            <tr>
                                                <td>
                                                    <span t-out="customer.name"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.get('move_name')"/>
                                                    -
                                                    <t t-out="line.get('ref')"/>
                                                    -
                                                    <t t-out="line.get('name')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('ref') or line.get('invoice_origin')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('journal_name')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('account_code')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('invoice_date')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('date_maturity')"/>
                                                </td>
                                                <td>
                                                    <span t-out="line.get('matching_number')"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="line.get('debit')"
                                                       t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="line.get('credit')"
                                                       t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                                </td>
                                                <td class="text-end">
                                                    <!--<t t-out="line.get('amount_currency')"/>-->
                                                </td>
                                                <td class="text-end">
                                                    <t t-set="pdc_running_balance" t-value="pdc_running_balance + line.get('balance', 0.0)"/>
                                                    <!--<span t-out="line.get('balance')"-->
                                                    <span t-out="pdc_running_balance"
                                                       t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <!--Empty Row-->
                                    <tr>
                                        <td colspan="12">
                                        </td>
                                    </tr>
                                </tbody>
                            </t>
                        </table>
                    </div>
                </main>
            </t>
        </template>

        <record id="action_report_pdc_full_pdf" model="ir.actions.report">
            <field name="name">Print PDC Report</field>
            <field name="model">postdate.cheque.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ng_financial_reports.report_pdc_full_pdf</field>
            <field name="print_report_name">'PL with PDC Report'</field>
            <field name="binding_model_id" ref="account.model_account_move"/> <!-- or remove this if not needed -->
        </record>

    </data>
</odoo>
